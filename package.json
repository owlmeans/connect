    "libraries/common/packages/basic-envelope",
    "libraries/common/packages/basic-ids",
    "libraries/common/packages/basic-keys",
    "libraries/common/packages/bot",
    "libraries/common/packages/captcha",
    "libraries/common/packages/client-config",
    "libraries/common/packages/client-context",
    "libraries/common/packages/client-entrypoint",
    "libraries/common/packages/client-route",
    "libraries/common/packages/config",
    "libraries/common/packages/consent",
    "libraries/common/packages/context",
    "libraries/common/packages/dep-config",
    "libraries/common/packages/entrypoint",
    "libraries/common/packages/error",
    "libraries/common/packages/i18n",
    "libraries/common/packages/iam",
    "libraries/common/packages/kluster",
    "libraries/common/packages/log",
    "libraries/common/packages/mailer",
    "libraries/common/packages/mongo",
    "libraries/common/packages/mongo-resource",
    "libraries/common/packages/oidc",
    "libraries/common/packages/payment",
    "libraries/common/packages/redis-resource",
    "libraries/common/packages/resource",
    "libraries/common/packages/route",
    "libraries/common/packages/server-api",
    "libraries/common/packages/server-app",
    "libraries/common/packages/server-auth",
    "libraries/common/packages/server-auth-identity",
