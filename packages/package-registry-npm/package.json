{
  "name": "@owlmeans/package-registry-npm",
  "version": "0.2.0-alpha.0",
  "description": "npm registry adapter for @owlmeans/package-inspector: packuments and readmes, bulk download counts of name neighbours, and the repository manifest name check.",
  "license": "MIT",
  "homepage": "https://owlmeans.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlmeans/connect.git",
    "directory": "packages/package-registry-npm"
  },
  "bugs": {
    "url": "https://github.com/owlmeans/connect/issues"
  },
  "author": "Igor Tkachenko <igor.tkachenko@owlmeans.com> (https://owlmeans.com)",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "sleep 67 && nodemon -e ts,tsx,json --watch src --exec \"tsc -p ./tsconfig.json\"",
    "watch": "tsc -b -w --preserveWatchOutput --pretty",
    "test": "bun test ./tests"
  },
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "default": "./build/index.js",
      "module": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "dependencies": {
    "@owlmeans/context": "^0.2.0-alpha.0",
    "@owlmeans/log": "^0.2.0-alpha.0",
    "@owlmeans/package-inspector": "^0.2.0-alpha.0"
  },
  "devDependencies": {
    "@owlmeans/dep-config": "^0.2.0-alpha.0",
    "@owlmeans/test": "^0.2.0-alpha.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
